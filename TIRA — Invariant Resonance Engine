# LAYER 4: ATTRACTOR KERNEL VERIFICATION
# ═══════════════════════════════════════════════════════════════════════
class AttractorSandboxEngine:
    """Layer 4: Evaluates state divergence against the core attractor kernel sequence."""
    def __init__(self, sequence: List[int] = ATTRACTOR_SEQUENCE) -> None:
        self.target_kernel = np.array(sequence, dtype=np.float64)

    def evaluate_attractor_distance(self, input_signal: np.ndarray) -> Tuple[bool, float]:
        """Calculates distance between signal projection and attractor kernel."""
        min_len = min(len(input_signal), len(self.target_kernel))
        signal_slice = input_signal[:min_len]
        kernel_slice = self.target_kernel[:min_len]
        
        norm_sig = signal_slice / (np.linalg.norm(signal_slice) + 1e-12)
        norm_ker = kernel_slice / (np.linalg.norm(kernel_slice) + 1e-12)
        
        distance = float(np.linalg.norm(norm_sig - norm_ker))
        is_aligned = distance <= 0.05
        return is_aligned, distance


