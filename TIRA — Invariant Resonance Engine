# GROSS-PITAEVSKII TOROIDAL SOLVER
# ═══════════════════════════════════════════════════════════════════════
class GrossPitaevskiiToroidalSolver:
    """Numerical solver for 1D/2D Toroidal Gross-Pitaevskii equation tied to vector phase alignment."""
    def __init__(self, grid_points: int = 128, r_major: float = 1.0, g_coupling: float = 1.0) -> None:
        self.N = grid_points
        self.theta = np.linspace(0, 2 * np.pi, grid_points, endpoint=False)
        self.d_theta = 2 * np.pi / grid_points
        self.g = g_coupling
        self.psi = np.ones(grid_points, dtype=np.complex128) / np.sqrt(2 * np.pi)

    def step_split_operator(self, dt: float, phase_boundary_coupling: float) -> None:
        """Advances wave function in time via Split-Operator Fourier Method."""
        v_ext = -phase_boundary_coupling * np.cos(self.theta)
        self.psi *= np.exp(-1j * (self.g * np.abs(self.psi)**2 + v_ext) * (dt / 2.0))
        
        k = np.fft.fftfreq(self.N, d=self.d_theta)
        psi_k = np.fft.fft(self.psi)
        psi_k *= np.exp(-1j * (0.5 * k**2) * dt)
        self.psi = np.fft.ifft(psi_k)
        
        self.psi *= np.exp(-1j * (self.g * np.abs(self.psi)**2 + v_ext) * (dt / 2.0))
        
        norm = np.sqrt(np.sum(np.abs(self.psi)**2) * self.d_theta)
        if norm > 0:
            self.psi /= norm

    def get_phase_coherence(self) -> float:
        """Calculates global order parameter phase coherence across torus."""
        phases = np.angle(self.psi)
        mean_vector = np.mean(np.exp(1j * phases))
        return float(np.abs(mean_vector))


