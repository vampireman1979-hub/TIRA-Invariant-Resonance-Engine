# LAYER 8: INTENT ANCHOR & PATTERN INTEGRITY — New Layer
# ═══════════════════════════════════════════════════════════════════════
class IntegrityReport(NamedTuple):
    """Immutable validation report from Layer 8 gate."""
    is_valid: bool
    alignment_score: float
    anchor_match: float
    pattern_complete: bool
    gaps: List[str]
    recommendations: List[str]


class IntentAnchorLayer:
    """
    Layer 8 — The Intent Anchor Gate:
    Final validation that output remains aligned with original intent
    and invariant geometry before release.
    """

    def __init__(
        self,
        invariant_kernel: List[int] = ATTRACTOR_SEQUENCE,
        anchor_freq: float = BASE_CARRIER_FREQ_HZ,
        threshold: float = INTEGRITY_THRESHOLD,
    ) -> None:
        self.invariant_kernel = np.array(invariant_kernel, dtype=np.float64)
        self.anchor_freq = anchor_freq
        self.threshold = threshold
        self._kernel_norm = np.linalg.norm(self.invariant_kernel)

    def extract_pattern_signature(
        self,
        output_sequence: List[int],
    ) -> np.ndarray:
        """Normalise output sequence to match invariant kernel length."""
        sig = np.array(output_sequence, dtype=np.float64)
        target_len = len(self.invariant_kernel)
        if len(sig) > target_len:
            sig = sig[:target_len]
        elif len(sig) < target_len:
            sig = np.pad(sig, (0, target_len - len(sig)))
        norm = np.linalg.norm(sig)
        return sig / norm if norm > 0 else sig

    def calculate_alignment(
        self,
        signature: np.ndarray,
    ) -> float:
        """Cosine similarity between output and invariant kernel."""
        if self._kernel_norm == 0:
            return 0.0
        unit_kernel = self.invariant_kernel / self._kernel_norm
        dot_product = np.dot(signature, unit_kernel)
        return float(np.clip(dot_product, -1.0, 1.0))

    def verify_anchor(
        self,
        intent_anchor: str,
        output_content: str,
    ) -> float:
        """Semantic anchor token match score."""
        intent_tokens = set(intent_anchor.lower().split())
        output_tokens = set(output_content.lower().split())
        if not intent_tokens:
            return 1.0
        intersection = intent_tokens & output_tokens
        return len(intersection) / len(intent_tokens)

    def check_completeness(
        self,
        output_sequence: List[int],
    ) -> Tuple[bool, List[str]]:
        """Verify all required invariant phases present."""
        gaps: List[str] = []
        seq_set = set(output_sequence)
        
        if 3 not in seq_set:
            gaps.append("Gate/Transition (3) missing")
        if 6 not in seq_set:
            gaps.append("Coordinate/Union (6) missing")
        if 0 not in seq_set:
            gaps.append("Centre/Silence (0) missing — cycle not closed")
        if 9 not in seq_set:
            gaps.append("Convergence/Unity (9) missing")
        
        return len(gaps) == 0, gaps

    def validate(
        self,
        intent_anchor: str,
        output_sequence: List[int],
        output_content: str,
    ) -> IntegrityReport:
        """Run full validation suite."""
        signature = self.extract_pattern_signature(output_sequence)
        alignment_score = self.calculate_alignment(signature)
        anchor_match = self.verify_anchor(intent_anchor, output_content)
        pattern_complete, gaps = self.check_completeness(output_sequence)

        is_valid = (
            alignment_score >= self.threshold
            and anchor_match >= self.threshold
            and pattern_complete
        )

        recommendations: List[str] = []
        if alignment_score < self.threshold:
            recommendations.append("Signal drifting from invariant pattern")
        if anchor_match < self.threshold:
            recommendations.append("Output diverges from core intent anchor")
        if not pattern_complete:
            recommendations.append("Pattern incomplete — missing phases")

        return IntegrityReport(
            is_valid=is_valid,
            alignment_score=round(alignment_score, 4),
            anchor_match=round(anchor_match, 4),
            pattern_complete=pattern_complete,
            gaps=gaps,
            recommendations=recommendations,
        )


